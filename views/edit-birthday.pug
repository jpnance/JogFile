extends layout
include partials/nav-menu

block content
	header.site-header
		.site-header-inner
			.site-header-left
				a.logo(href="/")
					img.logo-icon(src="/images/shoe.svg" alt="")
					span.logo-text JogFile
			.site-header-right
				+nav-menu()

	.form-page
		h1.page-title.page-title-birthday= person ? 'Edit Birthday' : 'Add Birthday'
		main.form-main
			.form-card(style="background: var(--jf-birthday)")
				form#editForm(method="POST" action=person ? `/birthdays/${person._id}/edit` : '/birthdays')
					.form-group
						label.form-label Name
						input.form-input(type="text" name="name" value=(person ? person.name : '') placeholder="e.g., Mom, David, Jane" required autofocus)

					.form-row
						.form-group
							label.form-label Month
							select.form-input(name="birthMonth" required)
								option(value="" disabled selected=!person) Select month
								- var months = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December']
								each month, i in months
									option(value=i+1 selected=(person && person.birthMonth === i+1))= month
						.form-group
							label.form-label Day
							select.form-input(name="birthDay" required)
								option(value="" disabled selected=!person) Day
								- for (var d = 1; d <= 31; d++)
									option(value=d selected=(person && person.birthDay === d))= d

					.form-group
						label.form-label Year (optional)
						input.form-input(type="number" name="birthYear" value=(person && person.birthYear ? person.birthYear : '') placeholder="e.g., 1985" min="1900" max="2030" style="width: 140px")
						.form-hint If you add a year, we'll show their age.

					.form-group
						label.form-label Notes (optional)
						textarea.form-input(name="notes" rows="2" placeholder="Gift ideas, etc." style="resize: vertical")= person ? person.notes : ''

			.form-actions
				.form-actions-row
					button.btn(type="submit" form="editForm" style="background: var(--jf-birthday); color: white")= person ? 'Save Changes' : 'Add Birthday'
					a.btn.btn-secondary(href="/birthdays") Cancel
				if person
					.form-actions-row
						form(method="POST" action=`/birthdays/${person._id}/delete` onsubmit="return confirm('Remove this birthday?')" style="flex: 1; display: flex")
							button.btn.btn-danger(type="submit") Delete
