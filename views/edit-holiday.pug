extends layout
include partials/nav-menu

block content
	header.site-header
		.site-header-inner
			.site-header-left
				a.logo(href="/")
					img.logo-icon(src="/images/shoe.svg" alt="")
					span.logo-text JogFile
			.site-header-center
			.site-header-right
				+nav-menu()

	.form-page
		h1.page-title.page-title-holiday= holiday ? 'Edit Holiday' : 'Add Holiday'
		main.form-main
			.form-card(style="background: var(--jf-holiday)")
				form#editForm(method="POST" action=holiday ? `/holidays/${holiday._id}/edit` : '/holidays')
					.form-group
						label.form-label Name
						input.form-input(type="text" name="name" value=(holiday ? holiday.name : '') placeholder="e.g., Labor Day, Christmas" required autofocus)

					.form-group
						label.form-label Repeats
						div(style="margin-top: 8px")
							label(style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px; cursor: pointer")
								input#recFixed(type="radio" name="recurrenceType" value="fixed" checked=(holiday ? (holiday.recurrenceType || 'fixed') === 'fixed' : true))
								span Same calendar date every year
							label(style="display: flex; align-items: center; gap: 8px; cursor: pointer")
								input#recNth(type="radio" name="recurrenceType" value="nth_weekday" checked=(holiday && holiday.recurrenceType === 'nth_weekday'))
								span A specific weekday (e.g. first Monday)

					.form-row
						.form-group
							label.form-label Month
							select.form-input(name="month" required)
								option(value="" disabled selected=!holiday) Select month
								- var months = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December']
								each month, i in months
									option(value=i+1 selected=(holiday && holiday.month === i+1))= month
						#fixedDayCol.form-group
							label.form-label Day
							select.form-input#day(name="day")
								option(value="" disabled=!holiday) Day
								- for (var d = 1; d <= 31; d++)
									option(value=d selected=(holiday && (holiday.recurrenceType || 'fixed') === 'fixed' && holiday.day === d))= d

					#nthWeekRow.form-row(style=(holiday && holiday.recurrenceType === 'nth_weekday') ? '' : 'display: none')
						.form-group
							label.form-label Weekday
							select.form-input#weekday(name="weekday")
								option(value="" disabled=true) Select
								each pair in [[1,'Monday'],[2,'Tuesday'],[3,'Wednesday'],[4,'Thursday'],[5,'Friday'],[6,'Saturday'],[0,'Sunday']]
									option(value=pair[0] selected=(holiday && holiday.recurrenceType === 'nth_weekday' && holiday.weekday === pair[0]))= pair[1]
						.form-group
							label.form-label Which one
							select.form-input#weekOrdinal(name="weekOrdinal")
								option(value="" disabled=true) Select
								each ord in [[1,'First'],[2,'Second'],[3,'Third'],[4,'Fourth'],[-1,'Last']]
									option(value=ord[0] selected=(holiday && holiday.recurrenceType === 'nth_weekday' && holiday.weekOrdinal === ord[0]))= ord[1]

					.form-hint(style="margin-bottom: 16px") Lunar or movable feasts (e.g. Easter): add them once as a fixed date when you know the day.

					.form-group
						label.form-label Notes (optional)
						textarea.form-input(name="notes" rows="2" placeholder="Traditions, reminders, etc." style="resize: vertical")= holiday ? holiday.notes : ''

			.form-actions
				.form-actions-row
					button.btn(type="submit" form="editForm" style="background: var(--jf-holiday); color: white")= holiday ? 'Save Changes' : 'Add Holiday'
					a.btn.btn-secondary(href="/holidays") Cancel
				if holiday
					.form-actions-row
						form(method="POST" action=`/holidays/${holiday._id}/delete` onsubmit="return confirm('Remove this holiday?')" style="flex: 1; display: flex")
							button.btn.btn-danger(type="submit") Delete

	script.
		(function () {
			var recFixed = document.getElementById('recFixed');
			var recNth = document.getElementById('recNth');
			var fixedDayCol = document.getElementById('fixedDayCol');
			var nthWeekRow = document.getElementById('nthWeekRow');
			var day = document.getElementById('day');
			var weekday = document.getElementById('weekday');
			var weekOrdinal = document.getElementById('weekOrdinal');

			function sync() {
				var nth = recNth && recNth.checked;
				if (nthWeekRow) nthWeekRow.style.display = nth ? '' : 'none';
				if (fixedDayCol) fixedDayCol.style.display = nth ? 'none' : '';
				if (day) {
					day.required = !nth;
					day.disabled = nth;
				}
				if (weekday) {
					weekday.required = !!nth;
					weekday.disabled = !nth;
				}
				if (weekOrdinal) {
					weekOrdinal.required = !!nth;
					weekOrdinal.disabled = !nth;
				}
			}

			if (recFixed) recFixed.addEventListener('change', sync);
			if (recNth) recNth.addEventListener('change', sync);
			sync();
		})();
