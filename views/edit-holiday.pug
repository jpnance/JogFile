extends layout

block content
	main.container.py-4
		.row.justify-content-center
			.col-12.col-lg-10.col-xl-8
				a.nav-link-secondary.mb-3(href="/holidays")
					i.bi.bi-arrow-left.me-1
					| Back to Holidays

				.page-header
					if holiday
						h1 Edit Holiday
					else
						h1 Add Holiday

				.card
					.card-body
						form(method="POST" action=holiday ? `/holidays/${holiday._id}/edit` : '/holidays')
							.mb-3
								label.form-label(for="name") Name
								input.form-control#name(
									type="text"
									name="name"
									value=(holiday ? holiday.name : '')
									placeholder="e.g., Christmas, Tax day"
									required
									autofocus
								)

							.row.mb-3
								.col-6
									label.form-label(for="month") Month
									select.form-select#month(name="month" required)
										option(value="" disabled selected=!holiday) Select month
										- var months = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December']
										each month, i in months
											option(value=i+1 selected=(holiday && holiday.month === i+1))= month

								.col-6
									label.form-label(for="day") Day
									select.form-select#day(name="day" required)
										option(value="" disabled selected=!holiday) Day
										- for (var d = 1; d <= 31; d++)
											option(value=d selected=(holiday && holiday.day === d))= d

							.mb-3
								label.form-label(for="notes") Notes (optional)
								textarea.form-control#notes(
									name="notes"
									rows="2"
									placeholder="Traditions, reminders, etc."
								)= holiday ? holiday.notes : ''

							.d-flex.gap-2
								button.btn.btn-holiday(type="submit")
									if holiday
										| Save Changes
									else
										| Add Holiday
								a.btn.btn-outline-secondary(href="/holidays") Cancel
