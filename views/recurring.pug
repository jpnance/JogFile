extends layout
include partials/nav-menu
include partials/add-button

block content
	header.site-header
		.site-header-inner
			.site-header-left
				a.header-back(href="/")
					i.bi.bi-arrow-left
					span Back
			.site-header-center Recurring
			.site-header-right
				+nav-menu()
				+add-button("/recurring/new", "btn-add-task-recurring")

	.list-page

		main.list-main
			if totalCount === 0
				.empty-state(style="color: var(--jf-text-secondary)")
					.empty-state-icon
						i.bi.bi-arrow-repeat
					.empty-state-text No recurring tasks yet
					a.btn.btn-primary(href="/recurring/new" style="margin-top: 16px; flex: none; background: var(--jf-recurring)") Create your first

			else
				each group in groups
					if group.items.length > 0
						.list-section(style="background: var(--jf-recurring)")
							.list-section-header(onclick="this.parentElement.classList.toggle('collapsed')")
								i.bi.bi-chevron-down.list-section-chevron
								span.list-section-title= group.name
								span.list-section-count= group.items.length
							.list-section-content
								each rec in group.items
									- var nextOccurrence = rec.getNextOccurrence()
									.list-item(style="position: relative")
										if !rec.isActive || rec.isPaused()
											.list-item-pills
												if !rec.isActive
													span.list-item-pill Inactive
												if rec.isPaused()
													span.list-item-pill Paused
										.list-item-content
											.list-item-name= rec.title
											.list-item-meta
												= rec.getPatternDescription()
												if nextOccurrence
													|  · Next: #{nextOccurrence.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}
											if rec.description
												div(style="font-size: 12px; opacity: 0.7; margin-top: 4px")= rec.description
										.list-item-actions
											form(method="POST" action=`/recurring/${rec._id}/create-task` style="display: inline")
												button.list-item-btn.list-item-btn-action(type="submit") Today
											a.list-item-btn.list-item-btn-edit(href=`/recurring/${rec._id}/edit`) Edit
											form(method="POST" action=`/recurring/${rec._id}/delete` onsubmit="return confirm('Delete this recurring task?')" style="display: inline")
												button.list-item-btn.list-item-btn-delete(type="submit") Delete
