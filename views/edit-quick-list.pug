extends layout

block content
	main.container.py-4
		.row.justify-content-center
			.col-12.col-lg-10.col-xl-8
				a.nav-link-secondary.mb-3(href="/")
					i.bi.bi-arrow-left.me-1
					| Back to Today

				.page-header
					if quickList
						h1 Edit Quick List
					else
						h1 New Quick List

				.card
					.card-body
						form(method="POST" action=quickList ? `/quick-lists/${quickList._id}/edit` : '/quick-lists')
							.mb-3
								label.form-label(for="name") Name
								input.form-control#name(
									type="text"
									name="name"
									value=(quickList ? quickList.name : '')
									placeholder="e.g., Groceries, Ideas, To call"
									required
									autofocus
								)

							.d-flex.gap-2
								button.btn.btn-quick-list(type="submit")
									if quickList
										| Save Changes
									else
										| Create List
								a.btn.btn-outline-secondary(href="/") Cancel
