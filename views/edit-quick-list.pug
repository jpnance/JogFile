extends layout
include partials/nav-menu

block content
	header.site-header
		.site-header-inner
			.site-header-left
				a.logo(href="/")
					img.logo-icon(src="/images/shoe.svg" alt="")
					span.logo-text JogFile
			.site-header-right
				+nav-menu()

	.form-page
		h1.page-title.page-title-lists= quickList ? 'Edit Quick List' : 'New Quick List'
		main.form-main
			.form-card(style="background: var(--jf-lists)")
				form#editForm(method="POST" action=quickList ? `/quick-lists/${quickList._id}/edit` : '/quick-lists')
					.form-group
						label.form-label Name
						input.form-input(type="text" name="name" value=(quickList ? quickList.name : '') placeholder="e.g., Groceries, Ideas, To call" required autofocus)

			.form-actions
				.form-actions-row
					button.btn(type="submit" form="editForm" style="background: var(--jf-lists); color: white")= quickList ? 'Save Changes' : 'Create List'
					a.btn.btn-secondary(href="/") Cancel
				if quickList
					.form-actions-row
						form(method="POST" action=`/quick-lists/${quickList._id}/delete` onsubmit="return confirm('Delete this list and all its items?')" style="flex: 1; display: flex")
							button.btn.btn-danger(type="submit") Delete
