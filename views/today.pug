extends layout

block content
	main.container.py-4
		.row.justify-content-center
			.col-12.col-lg-10.col-xl-8
				//- Page header
				.page-header
					.d-flex.align-items-center.gap-2
						img.shoe-logo(src="/images/shoe.svg" alt="")
						h1 JogFile
					.d-flex.align-items-center.gap-2
						//- Manage dropdown
						.dropdown
							button.btn.btn-outline-secondary.btn-sm.dropdown-toggle(type="button" data-bs-toggle="dropdown" aria-expanded="false")
								i.bi.bi-list
								span.d-none.d-sm-inline  Manage
							ul.dropdown-menu.dropdown-menu-end
								li
									a.dropdown-item(href="/birthdays")
										i.bi.bi-cake2.me-2
										| Birthdays
								li
									a.dropdown-item(href="/holidays")
										i.bi.bi-stars.me-2
										| Holidays
								li
									a.dropdown-item(href="/recurring")
										i.bi.bi-arrow-repeat.me-2
										| Recurring
								li
									a.dropdown-item(href="/chores")
										i.bi.bi-wrench.me-2
										| Chores
								li
									a.dropdown-item(href="/quick-lists")
										i.bi.bi-card-list.me-2
										| Quick Lists

						//- Add button
						button.btn.btn-primary.btn-sm(type="button" data-bs-toggle="collapse" data-bs-target="#addTaskForm" aria-expanded="false" aria-controls="addTaskForm")
							span +
							span.d-none.d-sm-inline  Add

				//- Add task form (collapsible)
				#addTaskForm.collapse.mb-4
					.add-task-card
						form(method="POST" action="/tasks")
							.d-flex.gap-2
								input#addTaskInput.form-control.flex-grow-1(type="text" name="title" placeholder="What needs to be done?" required autocomplete="off")
								button.btn.btn-primary(type="submit") Add
							.destination-selector
								label.destination-option
									input(type="radio" name="destination" value="today" checked)
									span Today
								label.destination-option
									input(type="radio" name="destination" value="tomorrow")
									span Tomorrow
								label.destination-option
									input#destDate(type="radio" name="destination" value="date")
									span Schedule
							#scheduleDateWrap.schedule-date-wrap.d-none.mt-2
								.d-flex.gap-3.align-items-end
									div
										label.small.text-muted.mb-1.d-block(for="scheduledForDate") Date
										input#scheduledForDate.form-control.form-control-sm(type="date" name="scheduledFor" style="max-width: 10rem")
									div
										label.small.text-muted.mb-1.d-block(for="timeOfDayAdd") Time (optional)
										input#timeOfDayAdd.form-control.form-control-sm(type="time" name="timeOfDay" style="max-width: 8rem")

						if chores && chores.length > 0
							.chore-quick-add
								.chore-quick-add-label From a chore:
								.chore-quick-add-list
									each chore in chores
										form.d-inline(method="POST" action=`/chores/${chore._id}/create-task`)
											input(type="hidden" name="destination" value="today")
											button.btn.btn-sm.btn-outline-chore(type="submit")= chore.title

				script.
					// Show/hide date input when Schedule is selected
					const scheduleDateWrap = document.getElementById('scheduleDateWrap');
					const dateRadio = document.getElementById('destDate');
					const destinationRadios = document.querySelectorAll('input[name="destination"]');
					function updateScheduleDateVisibility() {
						if (dateRadio && scheduleDateWrap) {
							scheduleDateWrap.classList.toggle('d-none', !dateRadio.checked);
						}
					}
					destinationRadios.forEach(radio => radio.addEventListener('change', updateScheduleDateVisibility));
					updateScheduleDateVisibility();
					// Focus the title input when the form is shown
					const addTaskForm = document.getElementById('addTaskForm');
					const addTaskInput = document.getElementById('addTaskInput');
					if (addTaskForm && addTaskInput) {
						addTaskForm.addEventListener('shown.bs.collapse', () => addTaskInput.focus());
					}

				//- Pinned tasks — always at the top as tiles
				if pinnedTasks && pinnedTasks.length > 0
					section.pinned-grid.mb-4(aria-label="Pinned tasks")
						each task in pinnedTasks
							a.pinned-tile(href=`/tasks/${task._id}/edit`)
								span.pinned-tile-title= task.title
								if task.scheduledFor
									span.pinned-tile-date= formatDate(task.scheduledFor)
					.section-divider

				//- Today's birthdays (task-like rows; not in Coming up grid)
				if todayBirthdays && todayBirthdays.length > 0
					section.today-birthday-strip.mb-4(aria-label="Birthdays today")
						each b in todayBirthdays
							.today-birthday-item.d-flex.align-items-center(class=b.hasNotes ? 'today-birthday-item-notes' : '')
								span.today-birthday-leading.me-3(aria-hidden="true")
									i.bi.bi-cake2
								.today-birthday-body.flex-grow-1
									a.today-birthday-name(href=`/birthdays/${b.person._id}/edit`)= b.person.name
									if b.turningAge
										span.today-birthday-meta  · turning #{b.turningAge}

				if todayHolidays && todayHolidays.length > 0
					section.today-holiday-strip.mb-4(aria-label="Holidays today")
						each h in todayHolidays
							.today-holiday-item.d-flex.align-items-center(class=h.hasNotes ? 'today-holiday-item-notes' : '')
								span.today-holiday-leading.me-3(aria-hidden="true")
									i.bi.bi-stars
								.today-holiday-body.flex-grow-1
									a.today-holiday-name(href=`/holidays/${h.holiday._id}/edit`)= h.holiday.name

				//- Today's tasks
				- var hasTodayBirthdays = todayBirthdays && todayBirthdays.length > 0
				- var hasTodayHolidays = todayHolidays && todayHolidays.length > 0
				if tasks.length === 0 && !hasTodayBirthdays && !hasTodayHolidays
					.empty-state
						.empty-state-icon
							i.bi.bi-check-lg
						p All clear for today
				else if tasks.length > 0
					.task-list.mb-4
						each task in tasks
							include task


				.section-divider

				//- Next 3 days: birthdays + dated tasks — today’s birthdays are above the task list (cells always shown; may be empty)
				if comingUpDays && comingUpDays.length
					section.cu-grid.mb-4(aria-label="Tomorrow and the next two days")
						each day in comingUpDays
							.cu-grid-cell(class=day.offset === 1 ? 'cu-grid-cell-tomorrow' : '')
								.cu-grid-cell-head= day.label
								.cu-grid-cell-body
									if !day.items || !day.items.length
										p.cu-grid-empty.text-muted.small.mb-0 Nothing scheduled
									else
										ul.cu-grid-list
											each row in day.items
												if row.kind === 'birthday'
													li.cu-grid-line.cu-grid-birthday(class=row.hasNotes ? 'cu-grid-birthday-notes' : '')
														span.cu-grid-bullet(aria-hidden="true")
															i.bi.bi-cake2
														span.cu-grid-line-main
															a(href=`/birthdays/${row.person._id}/edit`)= row.person.name
															if row.turningAge
																span.cu-grid-meta  · #{row.turningAge}
												else if row.kind === 'holiday'
													li.cu-grid-line.cu-grid-holiday(class=row.hasNotes ? 'cu-grid-holiday-notes' : '')
														span.cu-grid-bullet(aria-hidden="true")
															i.bi.bi-stars
														span.cu-grid-line-main
															a(href=`/holidays/${row.holiday._id}/edit`)= row.holiday.name
												else if row.kind === 'task'
													- var isAppt = row.task.timeOfDay
													li.cu-grid-line.cu-grid-task(class=isAppt ? 'cu-grid-task-appt' : 'cu-grid-task-plain')
														span.cu-grid-bullet(aria-hidden="true")
															i.bi(class=isAppt ? 'bi-clock' : 'bi-calendar3')
														span.cu-grid-line-main
															a(href=`/tasks/${row.task._id}/edit`)= row.task.title
															if row.task.timeOfDay
																span.cu-grid-task-time= formatTaskTimeDisplay(row.task.timeOfDay)

				//- Quick Lists
				if quickLists && quickLists.length
					.section-divider

					section.ql-grid.mb-4(aria-label="Quick lists")
						each ql in quickLists
							.ql-card
								.ql-card-head
									a.ql-card-title(href=`/quick-lists/${ql._id}/edit`)= ql.name
								.ql-card-body
									ul.ql-items
										each item in ql.items
											li.ql-item
												span.ql-item-text= item.text
												form.ql-item-delete(method="POST" action=`/quick-lists/${ql._id}/items/${item._id}/delete`)
													button.ql-item-delete-btn(type="submit" title="Remove")
														i.bi.bi-x
										li.ql-item.ql-item-add
											form.ql-add-form(method="POST" action=`/quick-lists/${ql._id}/items`)
												input.ql-add-input(type="text" name="text" placeholder="Add…" autocomplete="off")

				.section-divider

				//- Later section (day 4+, same card style as Coming Up)
				if laterDays && laterDays.length
					.mb-2
						.section-header(data-bs-toggle="collapse" data-bs-target="#laterSection" aria-expanded="false")
							span.chevron ▶
							span.section-title Later
							span.section-count= laterDays.length
						#laterSection.collapse
							.py-2
								section.cu-grid.cu-grid-later(aria-label="Later days")
									each day in laterDays
										.cu-grid-cell
											.cu-grid-cell-head= day.label
											.cu-grid-cell-body
												ul.cu-grid-list
													each row in day.items
														if row.kind === 'birthday'
															li.cu-grid-line.cu-grid-birthday(class=row.hasNotes ? 'cu-grid-birthday-notes' : '')
																span.cu-grid-bullet(aria-hidden="true")
																	i.bi.bi-cake2
																span.cu-grid-line-main
																	a(href=`/birthdays/${row.person._id}/edit`)= row.person.name
																	if row.turningAge
																		span.cu-grid-meta  · #{row.turningAge}
														else if row.kind === 'holiday'
															li.cu-grid-line.cu-grid-holiday(class=row.hasNotes ? 'cu-grid-holiday-notes' : '')
																span.cu-grid-bullet(aria-hidden="true")
																	i.bi.bi-stars
																span.cu-grid-line-main
																	a(href=`/holidays/${row.holiday._id}/edit`)= row.holiday.name
														else if row.kind === 'task'
															- var isAppt = row.task.timeOfDay
															li.cu-grid-line.cu-grid-task(class=isAppt ? 'cu-grid-task-appt' : 'cu-grid-task-plain')
																span.cu-grid-bullet(aria-hidden="true")
																	i.bi(class=isAppt ? 'bi-clock' : 'bi-calendar3')
																span.cu-grid-line-main
																	a(href=`/tasks/${row.task._id}/edit`)= row.task.title
																	if row.task.timeOfDay
																		span.cu-grid-task-time= formatTaskTimeDisplay(row.task.timeOfDay)

				.section-divider

				//- Completed section
				.mb-2
					.section-header(data-bs-toggle="collapse" data-bs-target="#completedSection" aria-expanded="false")
						span.chevron ▶
						span.section-title Completed
						span.section-count= completedTasks.length
					#completedSection.collapse
						.px-4.py-2
							if completedTasks.length === 0
								p.text-muted.small.mb-0 Nothing completed recently
							else
								each task in completedTasks
									.task-preview.d-flex.align-items-center.justify-content-between
										span.text-muted= task.title
										form(method="POST" action=`/tasks/${task._id}/restore` style="margin: 0")
											button.btn.btn-sm.btn-outline-secondary(type="submit") Restore

				.section-divider

				//- Sticky Notes — always visible at bottom
				section.sticky-notes-section(aria-label="Sticky notes")
					.sticky-notes-grid
						if stickyNotes && stickyNotes.length
							each note in stickyNotes
								.sticky-note-tile
									span.sticky-note-text= note.text
									form.sticky-note-delete(method="POST" action=`/sticky-notes/${note._id}/delete`)
										button.sticky-note-delete-btn(type="submit" title="Remove")
											i.bi.bi-x
						.sticky-note-tile.sticky-note-add
							form.sticky-note-add-form(method="POST" action="/sticky-notes")
								input.sticky-note-input(type="text" name="text" placeholder="Add note..." autocomplete="off")
