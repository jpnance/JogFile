extends layout
include partials/nav-menu
include partials/day-of-note-item

block content
	header.site-header
		.site-header-inner
			.site-header-left
				a.logo(href="/")
					img.logo-icon(src="/images/shoe.svg" alt="")
					span.logo-text JogFile
			.site-header-right
				+nav-menu()
				button.btn-add-task(type="button")
					i.bi.bi-plus
					span.btn-add-task-text  Add

	//- Add task form (collapsible, hidden by default)
	#addTaskForm(style="display: none")
		.form-card.form-card-today
			form#taskForm(method="POST" action="/tasks" hx-post="/tasks" hx-target="#tasks-grid" hx-swap="outerHTML" hx-select="#tasks-grid" hx-select-oob="#coming-up-grid, #later-link" hx-on::after-request="onAddTaskSuccess(event)")
				.form-group
					input.form-input(type="text" name="title" placeholder="What needs to be done?" required autocomplete="off")
				.form-row
					label.form-check
						input(type="radio" name="destination" value="today" checked)
						span  Today
					label.form-check
						input(type="radio" name="destination" value="tomorrow")
						span  Tomorrow
					label.form-check
						input#destDate(type="radio" name="destination" value="date")
						span  Schedule
				#scheduleDateWrap.d-none
					.form-row(style="margin-top: 12px")
						.form-group
							label.form-label Date
							input#scheduledForDate.form-input(type="date" name="scheduledFor")
						.form-group
							label.form-label Time (optional)
							input#timeOfDayAdd.form-input(type="time" name="timeOfDay")
				button.btn.btn-solid-white(type="submit" style="margin-top: 16px; flex: none; padding: 12px 24px;") Add Task

			if chores && chores.length > 0
				div(style="margin-top: 16px; padding-top: 16px; border-top: 1px solid rgba(255,255,255,0.2); display: flex; flex-wrap: wrap; gap: 8px")
					each chore in chores
						form(method="POST" action=`/chores/${chore._id}/create-task` style="display: inline" hx-post=`/chores/${chore._id}/create-task` hx-target="#tasks-grid" hx-swap="outerHTML" hx-select="#tasks-grid" hx-select-oob="#coming-up-grid, #later-link" hx-on::after-request="onAddTaskSuccess(event)")
							input(type="hidden" name="destination" value="today")
							button.btn.btn-ghost.btn-sm(type="submit")= chore.title

	script.
		const addBtn = document.querySelector('.btn-add-task');
		const addTaskForm = document.getElementById('addTaskForm');
		const addTaskInput = addTaskForm ? addTaskForm.querySelector('input[name="title"]') : null;
		const scheduleDateWrap = document.getElementById('scheduleDateWrap');
		const dateRadio = document.getElementById('destDate');
		const destinationRadios = document.querySelectorAll('input[name="destination"]');

		function updateScheduleDateVisibility() {
			if (dateRadio && scheduleDateWrap) {
				scheduleDateWrap.classList.toggle('d-none', !dateRadio.checked);
			}
		}

		function dismissAddTaskPanel() {
			const taskForm = document.getElementById('taskForm');
			if (taskForm) taskForm.reset();
			if (scheduleDateWrap) scheduleDateWrap.classList.add('d-none');
			updateScheduleDateVisibility();
			if (addTaskForm) addTaskForm.style.display = 'none';
		}

		function onAddTaskSuccess(event) {
			if (event.detail.successful) dismissAddTaskPanel();
		}

		if (addBtn && addTaskForm) {
			addBtn.addEventListener('click', function() {
				const isHidden = addTaskForm.style.display === 'none';
				addTaskForm.style.display = isHidden ? 'block' : 'none';
				if (isHidden && addTaskInput) addTaskInput.focus();
			});
		}

		destinationRadios.forEach(radio => radio.addEventListener('change', updateScheduleDateVisibility));
		updateScheduleDateVisibility();

	//- Main content bands
	- var hasTasks = tasks && tasks.length > 0
	- var hasTodayBirthdays = todayBirthdays && todayBirthdays.length > 0
	- var hasTodayHolidays = todayHolidays && todayHolidays.length > 0
	- var hasTodayDaysOfNote = hasTodayBirthdays || hasTodayHolidays
	.bands
		//- Today section
		section.band.band-today
			#tasks-grid.tasks-grid
				if !hasTasks
					.empty-state
						i.bi.bi-check-lg
						span All clear for today
				else
					each task in tasks
						.task(id=`task-${task._id}`)
							form(method="POST" action=`/tasks/${task._id}/complete` style="display: contents" hx-post=`/tasks/${task._id}/complete` hx-target="#tasks-grid" hx-swap="outerHTML" hx-select="#tasks-grid" hx-select-oob="#done-flex")
								button.task-check(type="submit" title="Complete")
							.task-content
								.task-title
									if task.url
										a(href=task.url target="_blank" rel="noopener")= task.title
									else
										a(href=`/tasks/${task._id}/edit`)= task.title
									if task.generatedFrom
										i.bi.bi-arrow-repeat(style="margin-left: 6px; opacity: 0.6")
									if task.url
										i.bi.bi-link-45deg(style="margin-left: 4px; opacity: 0.5")
								if task.description
									.task-description= task.description
							if task.timeOfDay
								span.task-time= formatTaskTimeDisplay(task.timeOfDay)
							.task-actions
								a(href=`/tasks/${task._id}/edit`) •••

		//- Quick Lists section
		if quickLists && quickLists.length
			section.band.band-lists
				.lists-scroll
					each ql in quickLists
						.list-card(id=`ql-card-${ql._id}`)
							.list-card-head
								a(href=`/quick-lists/${ql._id}/edit`)= ql.name
							.list-card-body
								each item in ql.items
									.list-card-item
										span.list-card-item-text= item.text
										form(method="POST" action=`/quick-lists/${ql._id}/items/${item._id}/delete` style="display: inline" hx-post=`/quick-lists/${ql._id}/items/${item._id}/delete` hx-target=`#ql-card-${ql._id}` hx-swap="outerHTML" hx-select=`#ql-card-${ql._id}`)
											button(type="submit" title="Remove" style="background: none; border: none; color: rgba(255,255,255,0.5); cursor: pointer; padding: 0; font-size: 12px")
												i.bi.bi-x
								form(method="POST" action=`/quick-lists/${ql._id}/items` hx-post=`/quick-lists/${ql._id}/items` hx-target=`#ql-card-${ql._id}` hx-swap="outerHTML" hx-select=`#ql-card-${ql._id}` hx-on::after-request="this.reset()")
									input.list-card-add(type="text" name="text" placeholder="+ Add Item" autocomplete="off" style="width: 100%; cursor: text")

		//- Sticky Notes section
		section.band.band-notes
			#notes-flex.notes-flex
				if stickyNotes && stickyNotes.length
					each note in stickyNotes
						.note-pill
							a(href=`/sticky-notes/${note._id}/edit`)= note.text
							form(method="POST" action=`/sticky-notes/${note._id}/delete` style="display: inline; margin-left: 8px" hx-post=`/sticky-notes/${note._id}/delete` hx-target="#notes-flex" hx-swap="outerHTML" hx-select="#notes-flex")
								button(type="submit" title="Remove" style="background: none; border: none; color: rgba(255,255,255,0.5); cursor: pointer; padding: 0")
									i.bi.bi-x
				form(method="POST" action="/sticky-notes" style="display: inline" hx-post="/sticky-notes" hx-target="#notes-flex" hx-swap="outerHTML" hx-select="#notes-flex" hx-on::after-request="this.reset()")
					input.note-pill.note-add(type="text" name="text" placeholder="+ Add Note" autocomplete="off" style="border: 2px dashed rgba(255,255,255,0.4); background: transparent; color: white; cursor: text")

		//- Done section
		section.band.band-done
			#done-flex.done-flex
				if completedTasks && completedTasks.length
					each task in completedTasks
						.done-pill
							span= task.title
							form(method="POST" action=`/tasks/${task._id}/restore` style="display: inline; margin-left: 8px" hx-post=`/tasks/${task._id}/restore` hx-target="#done-flex" hx-swap="outerHTML" hx-select="#done-flex" hx-select-oob="#tasks-grid")
								button(type="submit" title="Restore" style="background: none; border: none; color: rgba(255,255,255,0.6); cursor: pointer; padding: 0; font-size: 11px")
									i.bi.bi-arrow-counterclockwise

		//- Right column (Birthday, Pinned, Coming Up)
		.right-column
			//- Today's days of note (birthdays, holidays, etc.)
			if hasTodayDaysOfNote
				section.band.band-birthday
					.coming-day-card
						if hasTodayBirthdays
							each b in todayBirthdays
								+dayOfNoteItem({ kind: 'birthday', person: b.person, turningAge: b.turningAge })
						if hasTodayHolidays
							each h in todayHolidays
								+dayOfNoteItem({ kind: 'holiday', holiday: h.holiday })

			//- Pinned tasks
			if pinnedTasks && pinnedTasks.length > 0
				section.band.band-pinned
					.pin-items
						each task in pinnedTasks
							a.pin-chip(href=`/tasks/${task._id}/edit`)
								i.bi.bi-pin-angle-fill
								span= task.title

			//- Coming Up (next 3 days)
			if comingUpDays && comingUpDays.length
				section.band.band-coming
					#coming-up-grid.coming-grid
						each day in comingUpDays
							.coming-day-card
								.coming-day-header= day.label
								if !day.items || !day.items.length
									.coming-empty Nothing scheduled
								else
									each row in day.items
										if row.kind === 'birthday' || row.kind === 'holiday'
											+dayOfNoteItem(row)
										else if row.kind === 'task'
											.coming-item
												span.coming-item-icon
													i.bi(class=row.task.timeOfDay ? 'bi-clock' : 'bi-calendar3')
												span.coming-item-title
													a(href=`/tasks/${row.task._id}/edit`)= row.task.title
												if row.task.timeOfDay
													span.coming-item-time= formatTaskTimeDisplay(row.task.timeOfDay)

	//- Later link (outside bands)
	#later-link
		if laterDays && laterDays.length
			- var laterCount = laterDays.reduce((sum, d) => sum + d.items.length, 0)
			if laterCount > 0
				a.later-link(href="/later")
					strong= laterCount
					|  items scheduled later →
