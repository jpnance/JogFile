extends layout

block content
	main.container.py-4
		.row.justify-content-center
			.col-12.col-lg-10.col-xl-8
				//- Page header
				.page-header
					.d-flex.align-items-center.gap-2
						img.shoe-logo(src="/images/shoe.svg" alt="")
						h1 JogFile
					.d-flex.align-items-center.gap-2
						//- Manage dropdown
						.dropdown
							button.btn.btn-outline-secondary.btn-sm.dropdown-toggle(type="button" data-bs-toggle="dropdown" aria-expanded="false")
								i.bi.bi-list
								span.d-none.d-sm-inline  Manage
							ul.dropdown-menu.dropdown-menu-end
								li
									a.dropdown-item(href="/birthdays")
										i.bi.bi-cake2.me-2
										| Birthdays
								li
									a.dropdown-item(href="/recurring")
										i.bi.bi-arrow-repeat.me-2
										| Recurring
								li
									a.dropdown-item(href="/chores")
										i.bi.bi-wrench.me-2
										| Chores

						//- Add button
						button.btn.btn-primary.btn-sm(type="button" data-bs-toggle="collapse" data-bs-target="#addTaskForm" aria-expanded="false" aria-controls="addTaskForm")
							span +
							span.d-none.d-sm-inline  Add

				//- Next 7 days at a glance (birthdays + dated tasks; today’s tasks stay in the list below)
				if comingUpDays && comingUpDays.length > 0
					section.cu-grid.mb-4(aria-label="Next seven days")
						each day in comingUpDays
							.cu-grid-cell
								.cu-grid-cell-head= day.label
								.cu-grid-cell-body
									each row in day.items
										if row.kind === 'birthday'
											.cu-grid-line.cu-grid-birthday(class=row.hasNotes ? 'cu-grid-birthday-notes' : '')
												a(href=`/birthdays/${row.person._id}/edit`)= row.person.name
												if row.turningAge
													span.cu-grid-meta  · #{row.turningAge}
										else if row.kind === 'task'
											.cu-grid-line.cu-grid-task
												a(href=`/tasks/${row.task._id}/edit`)= row.task.title
												if row.task.timeOfDay
													span.cu-grid-task-time= formatTaskTimeDisplay(row.task.timeOfDay)

				//- Add task form (collapsible)
				#addTaskForm.collapse.mb-4
					.add-task-card
						form(method="POST" action="/tasks")
							.d-flex.gap-2
								input#addTaskInput.form-control.flex-grow-1(type="text" name="title" placeholder="What needs to be done?" required autocomplete="off")
								button.btn.btn-primary(type="submit") Add
							.destination-selector
								label.destination-option
									input(type="radio" name="destination" value="today" checked)
									span Today
								label.destination-option
									input(type="radio" name="destination" value="tomorrow")
									span Tomorrow
								label.destination-option
									input#destDate(type="radio" name="destination" value="date")
									span Schedule
								label.destination-option
									input(type="radio" name="destination" value="scratch")
									span Scratch Pad
							#scheduleDateWrap.schedule-date-wrap.d-none.mt-2
								label.small.text-muted.mb-1.d-block(for="scheduledForDate") Date
								input#scheduledForDate.form-control.form-control-sm(type="date" name="scheduledFor" style="max-width: 10rem")
							#scheduleTimeWrap.schedule-time-wrap.d-none.mt-2
								label.small.text-muted.mb-1.d-block(for="timeOfDayAdd") Time (optional)
								input#timeOfDayAdd.form-control.form-control-sm(type="time" name="timeOfDay" style="max-width: 8rem")

						if chores && chores.length > 0
							.chore-quick-add
								.chore-quick-add-label From a chore:
								.chore-quick-add-list
									each chore in chores
										form.d-inline(method="POST" action=`/chores/${chore._id}/create-task`)
											input(type="hidden" name="destination" value="today")
											button.btn.btn-sm.btn-outline-chore(type="submit")= chore.title

				script.
					// Show/hide date input when Schedule is selected; show optional time for any dated destination
					const scheduleDateWrap = document.getElementById('scheduleDateWrap');
					const scheduleTimeWrap = document.getElementById('scheduleTimeWrap');
					const dateRadio = document.getElementById('destDate');
					const destinationRadios = document.querySelectorAll('input[name="destination"]');
					function updateScheduleDateVisibility() {
						if (dateRadio && scheduleDateWrap) {
							scheduleDateWrap.classList.toggle('d-none', !dateRadio.checked);
						}
					}
					function updateTimeVisibility() {
						const dest = document.querySelector('input[name="destination"]:checked');
						const scratch = dest && dest.value === 'scratch';
						if (scheduleTimeWrap) scheduleTimeWrap.classList.toggle('d-none', scratch);
					}
					function onDestinationChange() {
						updateScheduleDateVisibility();
						updateTimeVisibility();
					}
					destinationRadios.forEach(radio => radio.addEventListener('change', onDestinationChange));
					updateScheduleDateVisibility();
					updateTimeVisibility();
					// Focus the title input when the form is shown
					const addTaskForm = document.getElementById('addTaskForm');
					const addTaskInput = document.getElementById('addTaskInput');
					if (addTaskForm && addTaskInput) {
						addTaskForm.addEventListener('shown.bs.collapse', () => addTaskInput.focus());
					}

				//- Today's tasks
				if tasks.length === 0
					.empty-state
						.empty-state-icon
							i.bi.bi-check-lg
						p All clear for today
				else
					.task-list.mb-4
						each task in tasks
							include task

				.section-divider

				//- Later section
				.mb-2
					.section-header(data-bs-toggle="collapse" data-bs-target="#laterSection" aria-expanded="false")
						span.chevron ▶
						span.section-title Later
						span.section-count= laterTasks.length
					#laterSection.collapse
						.px-4.py-2
							if laterTasks.length === 0
								p.text-muted.small.mb-0 Nothing scheduled
							else
								each task in laterTasks
									.task-preview
										a(href=`/tasks/${task._id}/edit`)= task.title
										if task.timeOfDay
											span.task-preview-time= formatTaskTimeDisplay(task.timeOfDay)
										.task-preview-date= formatDate(task.scheduledFor)

				.section-divider

				//- Scratch Pad section
				.mb-2
					.section-header(data-bs-toggle="collapse" data-bs-target="#scratchSection" aria-expanded="false")
						span.chevron ▶
						span.section-title Scratch Pad
						span.section-count= scratchPadTasks.length
					#scratchSection.collapse
						.px-4.py-2
							if scratchPadTasks.length === 0
								p.text-muted.small.mb-0 No items
							else
								each task in scratchPadTasks
									.task-preview.d-flex.align-items-center
										a(href=`/tasks/${task._id}/edit`)= task.title

				//- Completed section
				.mb-2
					.section-header(data-bs-toggle="collapse" data-bs-target="#completedSection" aria-expanded="false")
						span.chevron ▶
						span.section-title Completed
						span.section-count= completedTasks.length
					#completedSection.collapse
						.px-4.py-2
							if completedTasks.length === 0
								p.text-muted.small.mb-0 Nothing completed recently
							else
								each task in completedTasks
									.task-preview.d-flex.align-items-center.justify-content-between
										span.text-muted= task.title
										form(method="POST" action=`/tasks/${task._id}/restore` style="margin: 0")
											button.btn.btn-sm.btn-outline-secondary(type="submit") Restore
