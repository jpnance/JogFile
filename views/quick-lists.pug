extends layout
include partials/nav-menu
include partials/add-button

block content
	header.site-header
		.site-header-inner
			.site-header-left
				a.header-back(href="/")
					i.bi.bi-arrow-left
					span Back
			.site-header-center Quick Lists
			.site-header-right
				+nav-menu()
				+add-button("/quick-lists/new", "btn-add-task-lists")

	.list-page

		main.list-main
			if quickLists.length === 0
				.empty-state(style="color: var(--jf-text-secondary)")
					.empty-state-icon
						i.bi.bi-card-list
					.empty-state-text No quick lists yet
					a.btn.btn-primary(href="/quick-lists/new" style="margin-top: 16px; flex: none; background: var(--jf-lists)") Create your first

			else
				.list-section(style="background: var(--jf-lists)")
					.list-section-content(style="padding-top: 16px")
						each ql in quickLists
							.list-item
								.list-item-content
									.list-item-name= ql.name
									.list-item-meta= ql.items.length + ' item' + (ql.items.length === 1 ? '' : 's')
								.list-item-actions
									a.list-item-btn.list-item-btn-edit(href=`/quick-lists/${ql._id}/edit`) Edit
									form(method="POST" action=`/quick-lists/${ql._id}/delete` onsubmit="return confirm('Delete this list and all its items?')" style="display: inline")
										button.list-item-btn.list-item-btn-delete(type="submit") Delete
