extends layout

block content
	main.container.py-4
		.row.justify-content-center
			.col-12.col-lg-10.col-xl-8
				a.nav-link-secondary.mb-3(href="/")
					i.bi.bi-arrow-left.me-1
					| Back to Today

				.page-header
					h1 Quick Lists
					a.btn.btn-quick-list.btn-sm(href="/quick-lists/new") + New

				if quickLists.length === 0
					.empty-state
						.empty-state-icon
							i.bi.bi-card-list
						p No quick lists yet
						a.btn.btn-quick-list(href="/quick-lists/new") Create your first

				else
					each ql in quickLists
						.quick-list-admin-item
							.quick-list-admin-content
								.quick-list-admin-name= ql.name
								.quick-list-admin-count= ql.items.length + ' item' + (ql.items.length === 1 ? '' : 's')
							.quick-list-admin-actions
								a.btn.btn-sm.btn-outline-secondary(href=`/quick-lists/${ql._id}/edit`) Edit
								form(method="POST" action=`/quick-lists/${ql._id}/delete` onsubmit="return confirm('Delete this list and all its items?')")
									button.btn.btn-sm.btn-outline-danger(type="submit") Delete
