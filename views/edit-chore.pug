extends layout

block content
	.form-page
		header.form-header
			a.form-header-back(href="/chores")
				i.bi.bi-arrow-left
				span Back
			span.form-header-title= chore ? 'Edit Chore' : 'Add Chore'
			.form-header-spacer

		main.form-main
			.form-card(style="background: var(--jf-chore)")
				form#editForm(method="POST" action=chore ? `/chores/${chore._id}/edit` : '/chores')
					.form-group
						label.form-label Title
						input.form-input(type="text" name="title" value=(chore ? chore.title : '') placeholder="e.g., Refill prescription" required autofocus)

					.form-group
						label.form-label Notes (optional)
						textarea.form-input(name="description" rows="3" placeholder="Prescription number, details, etc." style="resize: vertical")= chore ? chore.description : ''

					.form-group
						label.form-label URL (optional)
						input.form-input(type="url" name="url" value=(chore ? chore.url : '') placeholder="https://...")
						.form-hint A quick-action link for the spawned task.

			.form-actions
				.form-actions-row
					button.btn(type="submit" form="editForm" style="background: var(--jf-chore); color: white")= chore ? 'Save Changes' : 'Add Chore'
					a.btn.btn-secondary(href="/chores") Cancel
				if chore
					.form-actions-row
						form(method="POST" action=`/chores/${chore._id}/delete` onsubmit="return confirm('Delete this chore?')" style="flex: 1; display: flex")
							button.btn.btn-danger(type="submit") Delete
