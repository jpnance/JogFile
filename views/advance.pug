extends layout

block content
	- const birthdayCount = todaysBirthdays ? todaysBirthdays.length : 0
	- const totalItems = recurringPrompts.length + birthdayCount
	- const isRecurring = recurringPrompts.length > 0
	- const isBirthday = !isRecurring && birthdayCount > 0

	main.advance-page(class=isRecurring ? 'advance-page-recurring' : (isBirthday ? 'advance-page-birthday' : ''))
		if totalItems === 0
			.advance-empty
				.advance-empty-icon
					i.bi.bi-stars
				.advance-empty-title All caught up!
				.advance-empty-subtitle No items to process
				a.btn.btn-primary(href="/") Go to Today

		else if isRecurring
			- const recurring = recurringPrompts[0]
			.advance-card.advance-card-recurring
				.advance-body
					.advance-icon
						i.bi.bi-arrow-repeat
					.advance-title= recurring.title
					if recurring.description
						.advance-subtitle= recurring.description
					.advance-pattern= recurring.getPatternDescription()

					.advance-actions
						form(method="POST" action=`/advance/recurring/${recurring._id}/skip`)
							button.btn.btn-ghost(type="submit") Skip
						form(method="POST" action=`/advance/recurring/${recurring._id}/today`)
							button.btn.btn-solid-white(type="submit")
								i.bi.bi-plus-lg
								|  Today
						form(method="POST" action=`/advance/recurring/${recurring._id}/defer`)
							input(type="hidden" name="date" value=tomorrowDateStr)
							button.btn.btn-ghost(type="submit") Tomorrow

				.advance-schedule
					.advance-schedule-toggle(onclick="this.nextElementSibling.classList.toggle('show')")
						i.bi.bi-calendar-plus
						span Schedule for later
						i.bi.bi-chevron-down
					.advance-schedule-content
						.advance-quick-dates
							button.advance-quick-date(type="button" onclick="setNextMonday(this)") Next Week
							button.advance-quick-date(type="button" onclick="setNextFirstOfMonth(this)") Next Month
						form.advance-schedule-row(method="POST" action=`/advance/recurring/${recurring._id}/defer`)
							input.advance-schedule-input(type="date" name="date" required)
							button.advance-schedule-btn(type="submit") Schedule

		else if isBirthday
			- const person = todaysBirthdays[0]
			- const turningAge = person.getTurningAge(new Date())
			.advance-card.advance-card-birthday
				.advance-body
					.advance-icon
						i.bi.bi-cake2
					.advance-title #{person.name}'s Birthday!
					if turningAge
						.advance-subtitle Turning #{turningAge} today
					if person.notes
						.advance-pattern= person.notes

					.advance-actions
						form(method="POST" action=`/advance/birthday/${person._id}/acknowledge`)
							button.btn.btn-solid-white(type="submit") Got It

block scripts
	script.
		function setNextMonday(element) {
			const date = new Date();
			const dayOfWeek = date.getDay();
			const daysUntilMonday = (8 - dayOfWeek) % 7 || 7;
			date.setDate(date.getDate() + daysUntilMonday);
			const dateStr = date.toISOString().split('T')[0];
			const form = element.closest('.advance-schedule-content').querySelector('form');
			form.querySelector('input[type="date"]').value = dateStr;
		}

		function setNextFirstOfMonth(element) {
			const date = new Date();
			date.setMonth(date.getMonth() + 1, 1);
			const dateStr = date.toISOString().split('T')[0];
			const form = element.closest('.advance-schedule-content').querySelector('form');
			form.querySelector('input[type="date"]').value = dateStr;
		}
