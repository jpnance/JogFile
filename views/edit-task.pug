extends layout
include partials/nav-menu

block content
	header.site-header
		.site-header-inner
			.site-header-left
				a.logo(href="/")
					img.logo-icon(src="/images/shoe.svg" alt="")
					span.logo-text JogFile
			.site-header-center
			.site-header-right
				+nav-menu()

	.form-page
		h1.page-title.page-title-today Edit Task
		main.form-main
			.form-card.form-card-today
				if task.generatedFrom
					div(style="display: inline-flex; align-items: center; gap: 8px; background: rgba(255,255,255,0.2); padding: 10px 14px; border-radius: 10px; font-size: 13px; margin-bottom: 20px")
						i.bi.bi-arrow-repeat
						| Generated from 
						a(href=`/recurring/${task.generatedFrom._id}/edit` style="color: white; font-weight: 500")= task.generatedFrom.title

				form#editForm(method="POST" action=`/tasks/${task._id}/edit`)
					.form-group
						label.form-label Title
						input.form-input(type="text" name="title" value=task.title required)

					.form-group
						label.form-label Description
						input.form-input(type="text" name="description" value=task.description placeholder="Optional notes...")

					.form-group
						label.form-label Quick Action URL
						input.form-input(type="url" name="url" value=task.url placeholder="https://...")
						.form-hint Clicking the task will open this URL

					.form-row
						.form-group
							label.form-label Scheduled For
							- var dateValue = task.scheduledFor ? task.scheduledFor.toLocaleDateString('en-CA', { timeZone: 'America/Los_Angeles' }) : ''
							input.form-input(type="date" name="scheduledFor" value=dateValue required)
						.form-group#editTimeWrap(class=!task.scheduledFor ? 'd-none' : '')
							label.form-label Time (optional)
							input.form-input(type="time" name="timeOfDay" value=(task.timeOfDay || ''))

					.form-group
						.form-check
							input.form-check-input(type="checkbox" name="pinned" id="pinned" checked=task.pinned)
							div
								label.form-check-label(for="pinned") Pinned
								.form-check-hint Pinned tasks stay at the top of the home screen

			.form-actions
				.form-actions-row
					button.btn.btn-primary(type="submit" form="editForm") Save Changes
					a.btn.btn-secondary(href="/") Cancel
				.form-actions-row
					form(method="POST" action=`/tasks/${task._id}/complete` style="flex: 1; display: flex")
						button.btn.btn-success(type="submit") Mark Complete
					form(method="POST" action=`/tasks/${task._id}/archive` onsubmit="return confirm('Archive this task? Archived tasks cannot be recovered.')" style="flex: 0 0 auto; display: flex")
						button.btn.btn-danger(type="submit") Archive

	script.
		(function () {
			const dateInput = document.querySelector('input[name="scheduledFor"]');
			const timeWrap = document.getElementById('editTimeWrap');
			if (!dateInput || !timeWrap) return;
			function sync() {
				const hasDate = dateInput.value && String(dateInput.value).trim() !== '';
				timeWrap.classList.toggle('d-none', !hasDate);
			}
			dateInput.addEventListener('change', sync);
			dateInput.addEventListener('input', sync);
			sync();
		})();
