extends layout

block content
	main.container.py-4
		.row.justify-content-center
			.col-12.col-lg-10.col-xl-8
				a.nav-link-secondary.mb-3(href="/")
					i.bi.bi-arrow-left.me-1
					| Back to Today

				.card
					.card-body
						h4.mb-4 Edit Sticky Note

						form(method="POST" action=`/sticky-notes/${stickyNote._id}/edit`)
							.mb-3
								label.form-label(for="text") Note
								input.form-control#text(
									type="text"
									name="text"
									value=stickyNote.text
									required
									autofocus
								)

							.d-flex.gap-2
								button.btn.btn-warning(type="submit") Save
								a.btn.btn-outline-secondary(href="/") Cancel

				.card.mt-3
					.card-body
						form(method="POST" action=`/sticky-notes/${stickyNote._id}/delete` onsubmit="return confirm('Delete this sticky note?')")
							button.btn.btn-outline-danger(type="submit") Delete Note
