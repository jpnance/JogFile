extends layout

block content
	.form-page
		header.form-header
			a.form-header-back(href="/")
				i.bi.bi-arrow-left
				span Back
			span.form-header-title Edit Sticky Note
			.form-header-spacer

		main.form-main
			.form-card(style="background: var(--jf-notes)")
				form#editForm(method="POST" action=`/sticky-notes/${stickyNote._id}/edit`)
					.form-group
						label.form-label Note
						input.form-input(type="text" name="text" value=stickyNote.text required autofocus)

			.form-actions
				.form-actions-row
					button.btn(type="submit" form="editForm" style="background: var(--jf-notes); color: white") Save
					a.btn.btn-secondary(href="/") Cancel
				.form-actions-row
					form(method="POST" action=`/sticky-notes/${stickyNote._id}/delete` onsubmit="return confirm('Delete this sticky note?')" style="flex: 1; display: flex")
						button.btn.btn-danger(type="submit") Delete
