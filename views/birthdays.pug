extends layout
include partials/nav-menu
include partials/add-button

block content
	header.site-header
		.site-header-inner
			.site-header-left
				a.header-back(href="/")
					i.bi.bi-arrow-left
					span Back
			.site-header-center Birthdays
			.site-header-right
				+nav-menu()
				+add-button("/birthdays/new", "btn-add-task-birthday")

	.list-page

		main.list-main
			if totalCount === 0
				.empty-state(style="color: var(--jf-text-secondary)")
					.empty-state-icon
						i.bi.bi-cake2
					.empty-state-text No birthdays yet
					a.btn.btn-primary(href="/birthdays/new" style="margin-top: 16px; flex: none; background: var(--jf-birthday)") Add your first

			else
				//- Coming Up section
				if upcoming && upcoming.length > 0
					.list-section.list-section-birthday
						.list-section-header(onclick="this.parentElement.classList.toggle('collapsed')")
							i.bi.bi-chevron-down.list-section-chevron
							span.list-section-title Coming Up
							span.list-section-count= upcoming.length
						.list-section-content
							each item in upcoming
								.list-item
									.list-item-content
										.list-item-name= item.person.name
										.list-item-meta
											if item.isToday
												span(style="color: #fbbf24; font-weight: 600") Today! 
												| · 
											else if item.daysUntil === 1
												| Tomorrow · 
											else if item.daysUntil
												| in #{item.daysUntil} days · 
											= item.person.getBirthdayString()
											if item.turningAge
												span  (turning #{item.turningAge})
									.list-item-actions
										a.list-item-btn.list-item-btn-edit(href=`/birthdays/${item.person._id}/edit`) Edit
										form(method="POST" action=`/birthdays/${item.person._id}/delete` onsubmit="return confirm('Remove this birthday?')" style="display: inline")
											button.list-item-btn.list-item-btn-delete(type="submit") Delete

				//- All Birthdays by month
				each group in byMonth
					.list-section.list-section-neutral.collapsed
						.list-section-header(onclick="this.parentElement.classList.toggle('collapsed')")
							i.bi.bi-chevron-down.list-section-chevron
							span.list-section-title= group.name
							span.list-section-count= group.people.length
						.list-section-content
							each person in group.people
								.list-item
									.list-item-content
										.list-item-name= person.name
										.list-item-meta
											= person.getBirthdayString()
											- var nextBday = person.getNextBirthday()
											- var age = person.getTurningAge(nextBday)
											if age
												span  (turning #{age})
										if person.notes
											div(style="font-size: 12px; opacity: 0.7; margin-top: 4px")= person.notes
									.list-item-actions
										a.list-item-btn.list-item-btn-edit(href=`/birthdays/${person._id}/edit`) Edit
										form(method="POST" action=`/birthdays/${person._id}/delete` onsubmit="return confirm('Remove this birthday?')" style="display: inline")
											button.list-item-btn.list-item-btn-delete(type="submit") Delete
