extends layout

block content
	.login-page
		.login-card
			.login-title JogFile
			if error
				div(style="background: rgba(220,38,38,0.1); border: 1px solid rgba(220,38,38,0.2); color: var(--jf-danger); padding: 12px; border-radius: 8px; margin-bottom: 16px; font-size: 14px")= error
			form(method="POST" action="/login")
				input.login-input(type="password" name="password" autofocus placeholder="Enter password")
				button.login-btn(type="submit") Log in
