extends layout
include partials/nav-menu
include partials/add-button

block content
	header.site-header
		.site-header-inner
			.site-header-left
				a.logo(href="/")
					img.logo-icon(src="/images/shoe.svg" alt="")
					span.logo-text JogFile
			.site-header-center
			.site-header-right
				+nav-menu()
				+add-button("/chores/new", "btn-add-task-chore")

	.list-page
		h1.page-title.page-title-chore Chores

		main.list-main
			if chores.length === 0
				.empty-state(style="color: var(--jf-text-secondary)")
					.empty-state-icon
						i.bi.bi-wrench
					.empty-state-text No chores yet
					a.btn.btn-primary(href="/chores/new" style="margin-top: 16px; flex: none; background: var(--jf-chore)") Add your first

			else
				.list-section(style="background: var(--jf-chore)")
					.list-section-content(style="padding-top: 16px")
						each chore in chores
							.list-item
								.list-item-content
									.list-item-name= chore.title
									if chore.description
										.list-item-meta= chore.description
								.list-item-actions
									form(method="POST" action=`/chores/${chore._id}/create-task` style="display: inline")
										input(type="hidden" name="destination" value="today")
										button.list-item-btn.list-item-btn-action(type="submit") Today
									a.list-item-btn.list-item-btn-edit(href=`/chores/${chore._id}/edit`) Edit
									form(method="POST" action=`/chores/${chore._id}/delete` onsubmit="return confirm('Delete this chore?')" style="display: inline")
										button.list-item-btn.list-item-btn-delete(type="submit") Delete
